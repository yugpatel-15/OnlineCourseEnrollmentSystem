<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>@ViewData["Title"] - Course Enrollment</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css"></head>
<body>
<nav class="navbar navbar-dark bg-primary"><div class="container">
<a class="navbar-brand" asp-controller="Course" asp-action="Index">Course Enrollment</a>
<div><a class="btn btn-sm btn-light me-2" asp-controller="Course" asp-action="Index">Courses</a>
<a class="btn btn-sm btn-light" asp-controller="User" asp-action="Index">Users API</a></div></div></nav>
<main class="container py-4">
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@RenderBody()</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required:false)
</body></html>
